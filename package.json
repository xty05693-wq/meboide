{
  "name": "meboide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "meboide — лёгкая IDE на React",
  "author": "mebo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "codemirror": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@45.3.1": true
  },
  "build": {
    "appId": "com.meboide.app",
    "productName": "meboide",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
